#!/bin/bash
# Mock docker that intercepts clang-format image calls and runs local clang-format instead.
# Supports: docker run [docker-flags...] IMAGE [clang-format-args...]

# We only handle 'docker run ...' calls
if [ "$1" != "run" ]; then
  exec /usr/bin/docker "$@" 2>/dev/null || true
fi
shift  # remove 'run'

# Parse docker run args: skip docker-specific flags and their values.
# Once we find the image name (first non-flag arg), everything after is passed to clang-format.
image=""
clang_args=()
skip_next=0

for arg in "$@"; do
  if [ "$skip_next" = "1" ]; then
    skip_next=0
    continue
  fi

  # If we already found the image, collect remaining args for clang-format
  if [ -n "$image" ]; then
    clang_args+=("$arg")
    continue
  fi

  # Still looking for the image name - skip docker flags
  case "$arg" in
    --volume|-v|--workdir|-w|--entrypoint|--env|-e|--user|-u|--name|--network|--platform)
      skip_next=1
      continue
      ;;
    --rm|--interactive|-i|--tty|-t|--detach|-d|--privileged|--no-healthcheck)
      # flags without values to skip
      continue
      ;;
    -*)
      # other flags without values - skip
      continue
      ;;
    *)
      # First non-flag arg is the image name
      image="$arg"
      ;;
  esac
done

# Find the real clang-format binary
REAL_CF=""
for candidate in /usr/bin/clang-format-18 /usr/bin/clang-format-17 /usr/bin/clang-format-16 /usr/bin/clang-format-15 /usr/bin/clang-format; do
  if [ -x "$candidate" ]; then
    REAL_CF="$candidate"
    break
  fi
done

if [ -z "$REAL_CF" ]; then
  echo "mock-docker: clang-format not found on system" >&2
  exit 1
fi

exec "$REAL_CF" "${clang_args[@]}"
